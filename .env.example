# Server-only. Copy to .env.local; never commit real secrets.
AUTH_SECRET=
# Stable public origin, no trailing path. Local: http://localhost:3000
AUTH_URL=http://localhost:3000
# Neon PostgreSQL connection string
DATABASE_URL=
# Public Vercel Blob store. Connect the store to the Vercel project for OIDC,
# or supply a read-write token (also supported for local development).
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
